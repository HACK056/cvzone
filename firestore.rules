rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && userRole() in ['admin', 'super_admin'];
    }

    function isModeratorOrAdmin() {
      return signedIn() && userRole() in ['moderator', 'admin', 'super_admin'];
    }

    function hasActiveSubscription(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/subscriptions/$(uid))
        && get(/databases/$(database)/documents/subscriptions/$(uid)).data.status == 'Active'
        && get(/databases/$(database)/documents/subscriptions/$(uid)).data.endAt > request.time;
    }

    function immutableOwner() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt']);
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user';
      allow read: if isSelf(uid) || isAdmin();
      allow update: if (isSelf(uid) && immutableOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (signedIn() && (subscriptionId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create, update, delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if resource.data.active != false || isModeratorOrAdmin();
      allow create, update, delete: if isModeratorOrAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.active == true || isModeratorOrAdmin();
      allow create, update, delete: if isModeratorOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    match /cv_documents/{documentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && hasActiveSubscription(request.auth.uid)
          && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && hasActiveSubscription(request.auth.uid)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /portfolio/{id} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAdmin();
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isModeratorOrAdmin();
      allow delete: if isModeratorOrAdmin();
    }

    match /site_settings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /visits/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
